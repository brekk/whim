import type { Either } from "Either"
import type { Wish } from "Wish"

import type { Failure } from "@/Failure"

import {} from "Applicative"
import { Left, Right } from "Either"
import {} from "Functor"
import {} from "Json"
import List from "List"
import {} from "Monad"
import {} from "MonadRec"
import Ish from "Wish"
import { Wish } from "Wish"

import Failure from "@/Failure"
import { clearTimeout, setTimeout } from "@/Timers"



// WHIM BASED ARCHITECTURE

export type Whim a = Whim(Wish Failure a)
export idea = pipe(
  Ish.good,
  Whim,
)
export good = idea
nightmare :: Failure -> Whim a
export nightmare = pipe(
  Ish.bad,
  Whim,
)
export bad = nightmare
export toWish = where {
  Whim(w) =>
    w
}
fromWish :: (e -> Failure) -> Wish e a -> Whim a
export fromWish = (badPath, w) => pipe(
  Ish.mapRej(badPath),
  Whim,
)(w)
instance Functor Whim {
  map = (f, w) => Whim(map(f, toWish(w)))
}
instance Applicative Whim {
  ap = (mf, m) => Whim(ap(toWish(mf), toWish(m)))

  pure = idea
}
instance Monad Whim {
  chain = (f, m) => Whim(
    chain(
      pipe(
        f,
        toWish,
      ),
      toWish(m),
    ),
  )

  of = pure
}
instance MonadRec Whim {
  tailRecM = (f, a) => Whim(
    tailRecM(
      pipe(
        f,
        toWish,
      ),
      a,
    ),
  )
}
instance Semigroup (Whim a) {
  assoc = (a, b) => catchFail((first) => mapFailure(Failure.merge(first), b), a)
}
// break, like breakfast
break :: Breakable e => e -> Whim a
export break = pipe(
  Failure.failWith,
  nightmare,
)
mapFailure :: (Failure -> Failure) -> Whim a -> Whim a
export mapFailure = (f, w) => pipe(
  Ish.mapRej($, toWish(w)),
  Whim,
)(f)
catchFail :: (Failure -> Whim a) -> Whim a -> Whim a
export catchFail = (handler, w) => Whim(
  Ish.chainRej(
    pipe(
      handler,
      toWish,
    ),
    toWish(w),
  ),
)
catchTag :: String -> (Failure -> Whim a) -> Whim a -> Whim a
export catchTag = (tag, handler, w) => catchFail(
  (f) => where(f) {
    Failure.Failure(_t, _, _) =>
      _t == tag ? handler(f) : nightmare(f)

    _ =>
      nightmare(f)
  },
  w,
)
attempt :: Whim a -> Whim (Either Failure a)
export attempt = (w) => Whim(
  pipe(
    toWish,
    Ish.bichain(
      pipe(
        Left,
        Ish.good,
      ),
      pipe(
        Right,
        Ish.good,
      ),
    ),
  )(w),
)
settle :: Either Failure b -> Either Failure {} -> Whim b
export settle = (outcome, released) => where(#[outcome, released]) {
  #[Right(a), Right(_)] =>
    idea(a)

  #[Right(_), Left(l)] =>
    nightmare(l)

  #[Left(l), Right(_)] =>
    nightmare(l)

  #[Left(l1), Left(l2)] =>
    nightmare(Failure.merge(l1, l2))
}
// adjust when we potentially handle cancellation
bracket :: (a -> Whim {}) -> (a -> Whim b) -> Whim a -> Whim b
export bracket = (release, use, input) => chain(
  (res) => chain((outcome) => chain(settle(outcome), attempt(release(res))), attempt(use(res))),
  input,
)
finally :: Whim {} -> Whim a -> Whim a
export finally = (cleanup, w) => bracket(() => cleanup, () => w, pure({}))
fromBreakableWish :: Breakable e => Wish e a -> Whim a
export fromBreakableWish = fromWish(Failure.failWith)
after :: Integer -> a -> Whim a
export after = (ms, x) => pipe(
  Ish.after(ms),
  Whim,
)(x)
export badAfter = (ms, x) => pipe(
  Wish,
  Whim,
)(
  (badPath, _) => {
    id = setTimeout(() => { badPath(x) }, ms)
    return () => {
      clearTimeout(id)
    }
  },
)
withTimeout :: Integer -> Whim a -> Whim a
export withTimeout = (ms, w) => pipe(
  toWish,
  Ish.withTimeout(ms, Failure.Quitter(ms)),
  Whim,
)(w)
parallelN :: Integer -> List (Whim a) -> Whim (List a)
export parallelN = (n, whims) => pipe(
  map(toWish),
  Ish.parallelN(n),
  Whim,
)(whims)
export parallel = parallelN(-1)
collectBad :: List (Either Failure a) -> List Failure
collectBad = (xs) => where(xs) {
  [] =>
    []

  [Left(f), ...rest] =>
    [f, ...collectBad(rest)]

  [Right(_), ...rest] =>
    collectBad(rest)
}
collectGood :: List (Either Failure a) -> List a
collectGood = (xs) => where(xs) {
  [] =>
    []

  [Left(_), ...rest] =>
    collectGood(rest)

  [Right(a), ...rest] =>
    [a, ...collectGood(rest)]
}
collectN :: Integer -> List (Whim a) -> Whim (List a)
export collectN = (n, whims) => {
  fn = (badPath, goodPath) => {
    branch = 0
    index = 0
    observe :: Whim a -> Wish Failure (Either Failure a)
    observe = (w) => {
      i = index
      index := index + 1
      return pipe(
        toWish,
        Ish.bichain(
          (e) => {
            branch := branch + 1
            return pipe(
              Failure.ContextualFailure(i, branch),
              Left,
              Ish.good,
            )(e)
          },
          pipe(
            Right,
            Ish.good,
          ),
        ),
      )(w)
    }
    return pipe(
      map(observe),
      Ish.parallelN(n),
      Ish.fulfill(
        badPath,
        (agg) => {
          fails = collectBad(agg)
          return if (List.isEmpty(fails)) {
            pipe(
              collectGood,
              goodPath,
            )(agg)
          } else {
            pipe(
              Failure.MultiFailure,
              badPath,
            )(fails)
          }
        },
      ),
    )(whims)
  }
  return pipe(
    Wish,
    Whim,
  )(fn)
}
export collect = collectN(-1)
raceN :: Integer -> List (Whim a) -> Whim a
export raceN = (n, whims) => {
  fn = (badPath, goodPath) => {
    branch = 0
    index = 0

    fails = []
    record :: Whim a -> Wish {} a
    record = (w) => {
      i = index
      index := index + 1
      return pipe(
        toWish,
        Ish.mapRej(
          (e) => {
            branch := branch + 1
            fails := [Failure.ContextualFailure(i, branch, e), ...fails]
            return {}
          },
        ),
      )(w)
    }
    return pipe(
      map(record),
      Ish.raceN(n),
      Ish.fulfill(
        () => pipe(
          Failure.MultiFailure,
          badPath,
        )(fails),
        goodPath,
      ),
    )(whims)
  }
  return pipe(
    Wish,
    Whim,
  )(fn)
}
export race = raceN(-1)
export fulfill = (badPath, goodPath, whim) => pipe(
  toWish,
  Ish.fulfill(badPath, goodPath),
)(whim)
