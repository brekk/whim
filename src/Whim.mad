import type { Either } from "Either"
import type { Wish } from "Wish"

import type { Failure } from "@/Failure"

import {} from "Applicative"
import { Left, Right } from "Either"
import {} from "Functor"
import {} from "Json"
import List from "List"
import { Just, Nothing } from "Maybe"
import {} from "Monad"
import {} from "MonadRec"
import Wish from "Wish"

import Failure from "@/Failure"



// WHIM BASED ARCHITECTURE

export type Whim a = Whim(Wish Failure a)
export good = pipe(
  Wish.good,
  Whim,
)
bad :: Failure -> Whim a
export bad = pipe(
  Wish.bad,
  Whim,
)
export toWish = where {
  Whim(w) =>
    w
}
fromWish :: (e -> Failure) -> Wish e a -> Whim a
export fromWish = (badPath, w) => pipe(
  Wish.mapRej(badPath),
  Whim,
)(w)
instance Functor Whim {
  map = (f, w) => Whim(map(f, toWish(w)))
}
instance Applicative Whim {
  ap = (mf, m) => Whim(ap(toWish(mf), toWish(m)))

  pure = good
}
instance Monad Whim {
  chain = (f, m) => Whim(
    chain(
      pipe(
        f,
        toWish,
      ),
      toWish(m),
    ),
  )

  of = pure
}
instance MonadRec Whim {
  tailRecM = (f, a) => Whim(
    tailRecM(
      pipe(
        f,
        toWish,
      ),
      a,
    ),
  )
}
instance Semigroup (Whim a) {
  assoc = (a, b) => catchFail((first) => mapFailure(Failure.merge(first), b), a)
}
// break, like breakfast
break :: Breakable e => e -> Whim a
export break = pipe(
  Failure.failWith,
  bad,
)
mapFailure :: (Failure -> Failure) -> Whim a -> Whim a
export mapFailure = (f, w) => pipe(
  toWish,
  Wish.mapRej(f),
  Whim,
)(w)
catchFail :: (Failure -> Whim a) -> Whim a -> Whim a
export catchFail = (handler, w) => Whim(
  Wish.chainRej(
    pipe(
      handler,
      toWish,
    ),
    toWish(w),
  ),
)
catchBy :: (Failure -> Boolean) -> (Failure -> Whim a) -> Whim a -> Whim a
catchBy = (check, handler, w) => catchFail((f) => check(f) ? handler(f) : bad(f), w)
catchMaybe :: (a -> b) -> String -> (Failure -> Whim a) -> Whim a -> Whim a
export catchMaybe = (fn, x) => catchBy(
  pipe(
    fn,
    where {
      Just(_t) =>
        _t == x

      _ =>
        false
    },
  ),
)
catchTag :: String -> (Failure -> Whim a) -> Whim a -> Whim a
export catchTag = catchMaybe(Failure.tag)
catchMessage :: String -> (Failure -> Whim a) -> Whim a -> Whim a
export catchMessage = catchMaybe(Failure.message)
catchContext :: String -> (Failure -> Whim a) -> Whim a -> Whim a
export catchContext = catchMaybe(Failure.context)
attempt :: Whim a -> Whim (Either Failure a)
export attempt = (w) => Whim(
  pipe(
    toWish,
    Wish.bichain(
      pipe(
        Left,
        Wish.good,
      ),
      pipe(
        Right,
        Wish.good,
      ),
    ),
  )(w),
)
settle :: Either Failure a -> Either Failure b -> Whim a
export settle = (outcome, released) => where(#[outcome, released]) {
  #[Right(a), Right(_)] =>
    good(a)

  #[Right(_), Left(l)] =>
    bad(l)

  #[Left(l), Right(_)] =>
    bad(l)

  #[Left(l1), Left(l2)] =>
    bad(Failure.merge(l1, l2))
}
// adjust when we potentially handle cancellation
// guarantees resource cleanup.
// 1st: release. Runs after use, whether use succeeded or failed.
// 2nd: use
// 3rd: acquire
// release does not run if the Whim is cancelled mid-use.
bracket :: (a -> Whim {}) -> (a -> Whim b) -> Whim a -> Whim b
export bracket = (release, use, acquire) => chain(
  (res) => pipe(
    use,
    attempt,
    chain((outcome) => chain(settle(outcome), attempt(release(res)))),
  )(res),
  acquire,
)
type WhimPhase a = Acquiring | Held(a) | Done
start :: (Failure -> {}) -> (a -> {}) -> Whim a -> {}
export start = (badPath, goodPath, w) => {
  fulfill(badPath, goodPath, w)
  return {}
}
export hope = start(() => {}, () => {})
export bracketWithCancel = (release, use, acquire) => pipe(
  Wish.Wish,
  Whim,
)(
  (badPath, goodPath) => {
    phase = Acquiring
    cancelled = false
    step = 0
    cancelStep = Nothing
    cancelCurrent = () => where(cancelStep) {
      Just(c) =>
        c()

      _ =>
        {}
    }
    deliver = (w) => if (cancelled) {
      {}
    } else do {
      start(badPath, goodPath, w)
    }
    runStep = (_bad, _good, w) => {
      step := step + 1
      mine = step
      c = fulfill(_bad, _good, w)
      if (step == mine) do {
        cancelStep := Just(c)
      } else do {
        {}
      }
    }
    releaseThen = (res, outcome) => do {
      phase := Done
      runStep((_) => {}, (rez) => deliver(settle(outcome, rez)), attempt(release(res)))
    }
    onAcquired = (res) => if (cancelled) do {
      hope(release(res))
    } else do {
      phase := Held(res)
      runStep(
        (_) => {},
        (outcome) => if (cancelled) do {
          {}
        } else do {
          releaseThen(res, outcome)
        },
        attempt(use(res)),
      )
    }
    runStep(
      (f) => do {
        phase := Done
        deliver(bad(f))
      },
      onAcquired,
      acquire,
    )
    return () => {
      if (!cancelled) do {
        cancelled := true
        where(phase) {
          Acquiring =>
            cancelCurrent()

          Held(res) =>
            do {
              phase := Done
              cancelCurrent()
              hope(release(res))
            }

          Done =>
            {}
        }
      }
    }
  },
)
// Runs the first effect after the second, regardless of whether it completed
finally :: Whim {} -> Whim a -> Whim a
export finally = (cleanup, w) => bracket(() => cleanup, () => w, pure({}))
fromBreakableWish :: Breakable e => Wish e a -> Whim a
export fromBreakableWish = fromWish(Failure.failWith)
after :: Integer -> a -> Whim a
export after = (ms, x) => pipe(
  Wish.after(ms),
  Whim,
)(x)
badAfter :: Integer -> (a -> Failure) -> a -> Whim a
export badAfter = (ms, toFail, x) => pipe(
  Wish.after(ms),
  chain(Wish.bad),
  fromWish(toFail),
)(x)
withTimeout :: Integer -> Whim a -> Whim a
export withTimeout = (ms, w) => pipe(
  toWish,
  Wish.withTimeout(ms, Failure.Quitter(ms)),
  Whim,
)(w)
parallelN :: Integer -> List (Whim a) -> Whim (List a)
export parallelN = (n, whims) => pipe(
  map(toWish),
  Wish.parallelN(n),
  Whim,
)(whims)
export parallel = parallelN(-1)
collectBad :: List (Either Failure a) -> List Failure
collectBad = (xs) => where(xs) {
  [] =>
    []

  [Left(f), ...rest] =>
    [f, ...collectBad(rest)]

  [Right(_), ...rest] =>
    collectBad(rest)
}
collectGood :: List (Either Failure a) -> List a
collectGood = (xs) => where(xs) {
  [] =>
    []

  [Left(_), ...rest] =>
    collectGood(rest)

  [Right(a), ...rest] =>
    [a, ...collectGood(rest)]
}
collectN :: Integer -> List (Whim a) -> Whim (List a)
export collectN = (n, whims) => {
  collectWishes :: (Failure -> {}) -> (List a -> {}) -> {} -> {}
  collectWishes = (badPath, goodPath) => {
    branch = 0
    index = 0
    observe :: Whim a -> Wish Failure (Either Failure a)
    observe = (w) => {
      i = index
      index := index + 1
      return pipe(
        toWish,
        Wish.bichain(
          (e) => {
            branch := branch + 1
            return pipe(
              Failure.ContextualFailure(i, branch),
              Left,
              Wish.good,
            )(e)
          },
          pipe(
            Right,
            Wish.good,
          ),
        ),
      )(w)
    }
    endPath = (agg) => {
      fails = collectBad(agg)
      return if (List.isEmpty(fails)) {
        pipe(
          collectGood,
          goodPath,
        )(agg)
      } else {
        pipe(
          Failure.MultiFailure,
          badPath,
        )(fails)
      }
    }
    return pipe(
      map(observe),
      Wish.parallelN(n),
      Wish.fulfill(badPath, endPath),
    )(whims)
  }
  return pipe(
    Wish.Wish,
    Whim,
  )(collectWishes)
}
collect :: List (Whim a) -> Whim (List a)
export collect = collectN(-1)
raceN :: Integer -> List (Whim a) -> Whim a
export raceN = (n, whims) => {
  fn = (badPath, goodPath) => {
    branch = 0
    index = 0

    fails = []
    record :: Whim a -> Wish {} a
    record = (w) => {
      return pipe(
        toWish,
        Wish.mapRej(
          (e) => {
            fails := List.append(Failure.ContextualFailure(index, branch, e), fails)
            index := index + 1
            branch := branch + 1
            return {}
          },
        ),
      )(w)
    }
    return pipe(
      map(record),
      Wish.raceN(n),
      Wish.fulfill(
        () => pipe(
          Failure.MultiFailure,
          badPath,
        )(fails),
        goodPath,
      ),
    )(whims)
  }
  return pipe(
    Wish.Wish,
    Whim,
  )(fn)
}
export race = raceN(-1)
export fulfill = (badPath, goodPath, whim) => pipe(
  toWish,
  Wish.fulfill(badPath, goodPath),
)(whim)
