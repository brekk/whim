import Either from "Either"
import IO from "IO"
import List from "List"
import Test from "Test"
import Wish from "Wish"

import Study from "Study"

import F from "@/Failure"
import W from "@/Whim"



handleErrors :: String -> W.Whim a -> Wish Test.AssertionError a
handleErrors = (rawFail) => pipe(
  W.toWish,
  Wish.mapRej(
    where {
      F.Failure(_, _, x) =>
        Test.Error(x)

      _ =>
        Test.Error(rawFail)
    },
  ),
)
Study.reportAsync(
  pipe(
    W.good,
    handleErrors("good with async adapter"),
  ),
  "good with async adapter!",
  [#[200, 200]],
)
Study.asyncFail(
  pipe(
    W.bad,
    handleErrors("bad with async adapter"),
  ),
  "bad with async adapter!",
  [#[F.Failure("a", "b", "yes"), Test.Error("yes")]],
)
Study.reportAsync(
  pipe(
    W.good,
    map((x) => x * 2),
    ap(pure((x) => x / 3)),
    chain((x) => of(x * 7)),
    handleErrors("whim fp combos"),
  ),
  "whim fp combos",
  [#[200, ((200 * 2) / 3) * 7]],
)
Study.asyncFail(
  pipe(
    W.bad,
    (x) => x ++ W.bad(F.Failure("bad", "deets", "sir")),
    W.toWish,
    Wish.mapRej(
      where {
        F.MultiFailure(list) =>
          Test.AssertionError(show(List.length(list)), "2")

        _ =>
          Test.NotImplemented
      },
    ),
  ),
  "whim bad path aggregates failures",
  [#[F.Failure("bad", "info", "there"), Test.AssertionError("2", "2")]],
)
fromWish :: Wish String a -> Wish Test.AssertionError a
fromWish = pipe(
  W.fromWish((v) => F.Failure("fromWishTesting", "message", v)),
  handleErrors("fromWish"),
)
Study.asyncReport(fromWish, "fromWish", [#[(Wish.good("test") :: Wish String String), "test"]])
Study.asyncFail(fromWish, "fromWish", [#[(Wish.bad("test") :: Wish String {}), Test.Error("test")]])
catchTag = pipe(
  W.catchTag(
    "test",
    where {
      F.Failure(s, k, v) =>
        W.bad(F.Failure(s, k, v))

      _ =>
        W.bad(F.Failure("test", "catchTag", "barfo"))
    },
  ),
  handleErrors("catchTag"),
)
Study.asyncFail(
  catchTag,
  "catchTag fail",
  [
    #[W.bad(F.Failure("test", "yo", "yojimbo")), Test.Error("yojimbo")],
    #[W.bad(F.Quitter(2000)), Test.Error("catchTag")],
  ],
)
Study.asyncReport(catchTag, "catchTag", [#[W.good("whatever"), "whatever"]])
Study.asyncReport(
  pipe(
    W.attempt,
    handleErrors("attempt"),
  ),
  "attempt",
  [
    #[W.good("value"), Either.Right("value")],
    #[W.bad(F.Quitter(1000)), Either.Left(F.Quitter(1000))],
  ],
)
settle = pipe(
  Study.caseN2(W.settle),
  handleErrors("settle"),
)
Study.asyncReport(settle, "settle", [#[#[Either.Right("yes"), Either.Right("no")], "yes"]])
Study.asyncFail(
  settle,
  "settle fail",
  [
    #[#[Either.Right({}), Either.Left(F.Quitter(1000))], Test.Error("settle")],
    #[#[Either.Left(F.Quitter(1000)), Either.Right({})], Test.Error("settle")],
    #[#[Either.Left(F.Quitter(1000)), Either.Left(F.Quitter(2020))], Test.Error("settle")],
  ],
)
collect = pipe(
  W.collect,
  handleErrors("collect"),
)
Study.asyncReport(collect, "collect", [#[[W.good("a"), W.good("b"), W.good("c")], ["a", "b", "c"]]])
Study.asyncFail(
  pipe(
    W.collect,
    W.toWish,
    map(() => ({})),
    Wish.mapRej(
      where {
        F.MultiFailure(list) =>
          Test.Error(show(list))

        _ =>
          Test.Error("sad")
      },
    ),
  ),
  "collect fail",
  [
    #[
      [W.bad(F.Failure("a", "b", "c")), W.bad(F.Failure("d", "e", "f"))],
      Test.Error(
        `[ContextualFailure(0, 1, Failure("a", "b", "c")), ContextualFailure(1, 2, Failure("d", "e", "f"))]`,
      ),
    ],
    #[
      [W.good("yes"), W.bad(F.Failure("a", "b", "c"))],
      Test.Error(`[ContextualFailure(1, 1, Failure("a", "b", "c"))]`),
    ],
    #[
      [W.bad(F.Failure("a", "b", "c")), W.good("yes")],
      Test.Error(`[ContextualFailure(0, 1, Failure("a", "b", "c"))]`),
    ],
  ],
)
Study.asyncFail(
  pipe(
    W.race,
    W.toWish,
    map(() => ({})),
    Wish.mapRej(
      where {
        F.MultiFailure(list) =>
          Test.Error(show(list))

        _ =>
          Test.Error("sad")
      },
    ),
  ),
  "race",
  [
    #[
      [W.bad(F.Failure("a", "b", "c")), W.bad(F.Failure("d", "e", "f"))],
      Test.Error(
        `[ContextualFailure(0, 0, Failure("a", "b", "c")), ContextualFailure(1, 1, Failure("d", "e", "f"))]`,
      ),
    ],
    #[
      [W.good("yes"), W.bad(F.Failure("a", "b", "c"))],
      Test.Error(`[ContextualFailure(1, 1, Failure("a", "b", "c"))]`),
    ],
    #[
      [W.bad(F.Failure("a", "b", "c")), W.good("yes")],
      Test.Error(`[ContextualFailure(0, 1, Failure("a", "b", "c"))]`),
    ],
  ],
)
