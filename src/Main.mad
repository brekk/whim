import IO from "IO"
import Wish from "Wish"

import F from "@/Failure"
import Whim from "@/Whim"



main = () => {
  pipe(
    Whim.collect,
    map(IO.pTrace("WHAT?")),
    Whim.fulfill((e) => { IO.pTrace("BAD", e) }, (x) => { IO.pTrace("GOOD", x) }),
  )([Whim.after(2000, "xxx"), Whim.after(1000, "yyy"), Whim.after(3000, "zzz")])
}
