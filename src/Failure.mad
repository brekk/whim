import {} from "Json"
import List from "List"
import String from "String"



export type Misfit m = Misfit(String, String, String)
interface Breakable m {
  breaks :: m -> Misfit m
}
export type Failure
  = Failure(String, String, String)
  | Quitter(Integer)
  | MultiFailure(List Failure)
  | ContextualFailure(Integer, Integer, Failure)
failWith :: Breakable m => m -> Failure
export failWith = (e) => pipe(
  breaks,
  where {
    Misfit(a, b, c) =>
      Failure(a, b, c)
  },
)(e)
export toIndex = where {
  ContextualFailure(i, _, _) =>
    i

  _ =>
    0
}
export toBranch = where {
  ContextualFailure(_, i, _) =>
    i

  _ =>
    0
}
debris :: Failure -> List Failure
export debris = (x) => where(x) {
  MultiFailure(fs) =>
    fs

  _ =>
    [x]
}
merge :: Failure -> Failure -> Failure
export merge = (a, b) => MultiFailure(debris(a) ++ debris(b))
_sortify = (fn, f) => pipe(
  debris,
  List.sortBy((a, b) => compare(fn(a), fn(b))),
)(f)
sortByIndex :: Failure -> List Failure
export sortByIndex = _sortify(toIndex)
sortByArrival :: Failure -> List Failure
export sortByArrival = _sortify(toBranch)
import IO from "IO"



showFail :: Failure -> String
export showFail = (f) => {
  inner :: Failure -> String
  inner = where {
    Failure(t, m, _) =>
      t ++ ": " ++ m

    Quitter(ms) =>
      "timed out after " ++ show(ms) ++ "ms"

    MultiFailure(fs) =>
      "multiple failures: "
        ++ pipe(
          map(inner),
          String.join(", "),
        )(fs)

    ContextualFailure(i, _, x) =>
      "#" ++ show(i) ++ " " ++ showFail(x)
  }
  return inner(f)
}
